//@version=6
// TWI Gold Asia Breakout - the chart view of the TWI Gold Asia Breakout EA (same rules, all times UTC/GMT).
// Range 00:00-05:00; skip the day if width < 0.10 or > 0.80 x daily ATR(14) (yesterday's).
// 05:00: buy stop = high + 5% of width, sell stop = low - 5%; first touch wins (OCO). SL = the other level, TP = 1R.
// 15:00: unfilled levels expire. 16:00: an open trade is closed at the bar close.
// Tested 2020-26 on AAAFx gold: 6/7 years positive in replay and MT5, beat a coin flip 100%. Gold only.
// The tracker uses bar highs/lows with no spread, SL first if a bar touches both; use M1-M15 charts.
indicator("TWI Gold Asia Breakout", overlay = true, max_boxes_count = 200, max_lines_count = 500, max_labels_count = 500)

rngStart  = input.int(0,    "Range start (UTC hour)", minval = 0, maxval = 23)
rngEnd    = input.int(5,    "Range end / orders armed (UTC hour)", minval = 1, maxval = 23)
cancelH   = input.int(15,   "Cancel unfilled (UTC hour)", minval = 1, maxval = 23)
closeH    = input.int(16,   "Close trade (UTC hour)", minval = 1, maxval = 23)
bufPct    = input.float(5.0, "Entry buffer (% of range)", step = 0.5)
tgtR      = input.float(1.0, "Target (R)", step = 0.1)
minATR    = input.float(0.10, "Min range (x daily ATR)", step = 0.01)
maxATR    = input.float(0.80, "Max range (x daily ATR)", step = 0.01)
showTable = input.bool(true, "Show results table")

h = hour(time, "UTC")
dATR = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)

var float rHi = na
var float rLo = na
var int   rStartT = na
var bool  armed = false
var bool  skipped = false
var float bs = na
var float ss = na
var int   dir = 0
var float entry = na
var float sl = na
var float tp = na
var box   rBox = na
var line  lBuy = na
var line  lSell = na
var line  lSL = na
var line  lTP = na
var int   nTrades = 0
var int   nWins = 0
var float sumR = 0.0
var string status = "waiting"

inRange  = h >= rngStart and h < rngEnd
newRange = inRange and not (h[1] >= rngStart and h[1] < rngEnd)

if newRange
    rHi := high
    rLo := low
    rStartT := time
    armed := false
    skipped := false
    dir := 0
    status := "building range"
    rBox := box.new(time, high, time, low, xloc = xloc.bar_time, bgcolor = color.new(color.gray, 85), border_color = color.gray)
else if inRange and not na(rHi)
    rHi := math.max(rHi, high)
    rLo := math.min(rLo, low)
    box.set_top(rBox, rHi)
    box.set_bottom(rBox, rLo)
    box.set_right(rBox, time)

// 05:00: arm the OCO pair (or skip the day)
armNow = h == rngEnd and h[1] != rngEnd and not na(rHi)
if armNow
    w = rHi - rLo
    if na(dATR) or w < minATR * dATR or w > maxATR * dATR
        skipped := true
        status := "skipped (range " + str.tostring(w / dATR, "#.##") + " x ATR)"
        box.set_bgcolor(rBox, color.new(color.orange, 85))
    else
        armed := true
        bs := rHi + bufPct / 100 * w
        ss := rLo - bufPct / 100 * w
        status := "armed"
        lBuy  := line.new(time, bs, time, bs, xloc = xloc.bar_time, color = color.lime, width = 2)
        lSell := line.new(time, ss, time, ss, xloc = xloc.bar_time, color = color.red, width = 2)

// waiting for the first touch
filled = false
if armed and dir == 0 and h >= rngEnd and h < cancelH
    line.set_x2(lBuy, time)
    line.set_x2(lSell, time)
    hitB = high >= bs
    hitS = low <= ss
    if hitB or hitS
        dir := hitB and not hitS ? 1 : hitS and not hitB ? -1 : (close >= open ? 1 : -1)
        entry := dir == 1 ? bs : ss
        sl := dir == 1 ? ss : bs
        tp := entry + dir * tgtR * math.abs(entry - sl)
        filled := true
        status := dir == 1 ? "LONG" : "SHORT"
        lSL := line.new(time, sl, time, sl, xloc = xloc.bar_time, color = color.red, style = line.style_dashed)
        lTP := line.new(time, tp, time, tp, xloc = xloc.bar_time, color = color.lime, style = line.style_dashed)
        label.new(time, entry, dir == 1 ? "BUY" : "SELL", xloc = xloc.bar_time, style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? color.lime : color.red, textcolor = color.black, size = size.small)
if armed and dir == 0 and h >= cancelH
    armed := false
    status := "expired (no break)"

// managing the trade
closedR = float(na)
if dir != 0 and not filled
    line.set_x2(lSL, time)
    line.set_x2(lTP, time)
    hitSL = dir == 1 ? low <= sl : high >= sl
    hitTP = dir == 1 ? high >= tp : low <= tp
    if hitSL
        closedR := -1.0
    else if hitTP
        closedR := tgtR
    else if h >= closeH
        closedR := dir * (close - entry) / math.abs(entry - sl)
if not na(closedR)
    nTrades += 1
    nWins += closedR > 0 ? 1 : 0
    sumR += closedR
    label.new(time, close, str.tostring(closedR, "+#.##;-#.##") + "R", xloc = xloc.bar_time, style = label.style_label_left, color = closedR > 0 ? color.new(color.lime, 30) : color.new(color.red, 30), textcolor = color.white, size = size.tiny)
    status := "closed " + str.tostring(closedR, "+#.##;-#.##") + "R"
    dir := 0
    armed := false

alertcondition(filled and dir == 1, "Asia breakout BUY", "Gold Asia breakout: BUY triggered")
alertcondition(filled and dir == -1, "Asia breakout SELL", "Gold Asia breakout: SELL triggered")
alertcondition(armNow and armed, "Asia orders armed", "Gold Asia breakout: range set, levels armed")

var table t = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 20), border_width = 1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "TWI Gold Asia", text_color = color.white)
    table.cell(t, 1, 0, status, text_color = color.yellow)
    table.cell(t, 0, 1, "Trades", text_color = color.white)
    table.cell(t, 1, 1, str.tostring(nTrades), text_color = color.white)
    table.cell(t, 0, 2, "Win %", text_color = color.white)
    table.cell(t, 1, 2, nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "#") + "%" : "-", text_color = color.white)
    table.cell(t, 0, 3, "Total R", text_color = color.white)
    table.cell(t, 1, 3, str.tostring(sumR, "+#.#;-#.#"), text_color = sumR >= 0 ? color.lime : color.red)
    table.cell(t, 0, 4, "Levels", text_color = color.white)
    table.cell(t, 1, 4, armed ? str.tostring(bs, format.mintick) + " / " + str.tostring(ss, format.mintick) : "-", text_color = color.white)
