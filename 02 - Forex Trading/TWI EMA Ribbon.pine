//@version=6
// TWI EMA Ribbon - trend state + BUY marks + "trend loosening" exits. Same rules as the
// 2026-10-03 backtest (see EMA Ribbon Trend Research.md in the vault):
//   Ribbon = 6 EMAs. BUY when the ribbon first becomes fully stacked bullish (e1>e2>...>e6)
//   with the close above e1. Entry = NEXT bar open. Initial stop = StopMult x ATR(14).
//   Exit when e1 crosses below e3 (the ribbon loosens) or the stop is hit (stop checked first;
//   a bar touching the stop is scored -1R, also on the entry bar).
// The bearish stack is NOT a short entry: the backtest's shorts lost in every setting. It only
// turns the ribbon red. Short tracking is a research toggle, off by default.
// Evidence: edge found on XAUUSD H4 buys only (+69.5R / PF 1.50, 244 trades, 2020-2026, AAAFx
// data). M15/H1 and EURUSD/GBPUSD/USDJPY at every timeframe were flat or negative. TradingView's
// feed and history length differ from that test, so numbers here will not match it exactly.
// Calculations use closed bars only (nothing repaints). Results are in R, with an optional
// per-trade cost input; a chart shows bid prices only, so there is no real spread here.
indicator("TWI EMA Ribbon", shorttitle = "TWI Rbn", overlay = true, max_labels_count = 300)

// ---------------- Inputs ----------------
gRib = "Ribbon"
p1 = input.int(8,  "EMA 1 (fast)", minval = 1, group = gRib)
p2 = input.int(13, "EMA 2", minval = 1, group = gRib)
p3 = input.int(21, "EMA 3 (exit pair)", minval = 1, group = gRib)
p4 = input.int(34, "EMA 4", minval = 1, group = gRib)
p5 = input.int(55, "EMA 5", minval = 1, group = gRib)
p6 = input.int(89, "EMA 6 (slow)", minval = 1, group = gRib)
showFill = input.bool(true, "Fill the ribbon", group = gRib)

gTrd = "Trades (same rules as the backtest)"
stopMult = input.float(2.0, "Initial stop (x ATR14)", minval = 0.5, step = 0.25, group = gTrd)
costPx = input.float(0.0, "Cost per trade (price units, e.g. 0.5 for gold)", minval = 0.0, group = gTrd)
showStop = input.bool(true, "Draw the open trade's stop", group = gTrd)
trackShorts = input.bool(false, "Research: also track the bearish stack as shorts (lost in the backtest)", group = gTrd)

gHtf = "Higher-timeframe gate (UNTESTED, off by default)"
useHtf = input.bool(false, "Require HTF trend (HTF close vs its EMA)", group = gHtf)
htfTf = input.timeframe("D", "HTF", group = gHtf)
htfLen = input.int(50, "HTF EMA length", minval = 1, group = gHtf)

gDsp = "Display"
showBuy = input.bool(true, "BUY / SELL(research) marks", group = gDsp)
showExit = input.bool(true, "EXIT / STOP labels with R", group = gDsp)
showTable = input.bool(true, "Stats table", group = gDsp)
tblPos = input.string("Bottom Right", "Table position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = gDsp)

// ---------------- Ribbon ----------------
var int firstT = time
e1 = ta.ema(close, p1)
e2 = ta.ema(close, p2)
e3 = ta.ema(close, p3)
e4 = ta.ema(close, p4)
e5 = ta.ema(close, p5)
e6 = ta.ema(close, p6)
atr = ta.atr(14)

stackBull = e1 > e2 and e2 > e3 and e3 > e4 and e4 > e5 and e5 > e6
stackBear = e1 < e2 and e2 < e3 and e3 < e4 and e4 < e5 and e5 < e6
bull = stackBull and close > e1
bear = stackBear and close < e1
newBull = bull and not bull[1]
newBear = bear and not bear[1]

[hC, hE] = request.security(syminfo.tickerid, htfTf, [close[1], ta.ema(close, htfLen)[1]], lookahead = barmerge.lookahead_on)
okL = not useHtf or hC > hE
okS = not useHtf or hC < hE

// ---------------- Long trades ----------------
var bool pendL = false
var bool inL = false
var float entL = na
var float stopL = na
var float riskL = na
var float sigRiskL = na
var int nL = 0
var int winL = 0
var float grossL = 0.0
var float lossL = 0.0
bool buySig = false
float rL = na
string whyL = ""

if pendL
    pendL := false
    inL := true
    entL := open
    riskL := sigRiskL
    stopL := entL - riskL

if inL
    if low <= stopL
        rL := -1.0 - costPx / riskL
        whyL := "STOP"
    else if e1 < e3
        rL := (close - entL - costPx) / riskL
        whyL := "EXIT"
    if whyL != ""
        nL += 1
        if rL > 0
            winL += 1
            grossL += rL
        else
            lossL += -rL
        inL := false

if not inL and not pendL and newBull and okL
    pendL := true
    sigRiskL := stopMult * atr
    buySig := true

// ---------------- Short trades (research only) ----------------
var bool pendS = false
var bool inS = false
var float entS = na
var float stopS = na
var float riskS = na
var float sigRiskS = na
var int nS = 0
var int winS = 0
var float grossS = 0.0
var float lossS = 0.0
bool sellSig = false
float rS = na
string whyS = ""

if trackShorts
    if pendS
        pendS := false
        inS := true
        entS := open
        riskS := sigRiskS
        stopS := entS + riskS

    if inS
        if high >= stopS
            rS := -1.0 - costPx / riskS
            whyS := "STOP"
        else if e1 > e3
            rS := (entS - close - costPx) / riskS
            whyS := "EXIT"
        if whyS != ""
            nS += 1
            if rS > 0
                winS += 1
                grossS += rS
            else
                lossS += -rS
            inS := false

    if not inS and not pendS and newBear and okS
        pendS := true
        sigRiskS := stopMult * atr
        sellSig := true

// ---------------- Drawing ----------------
col = stackBull ? color.lime : stackBear ? color.red : color.gray
plot(e1, "EMA 1", color.new(col, 0), 2)
plot(e2, "EMA 2", color.new(col, 15), 1)
plot(e3, "EMA 3", color.new(col, 25), 1)
plot(e4, "EMA 4", color.new(col, 40), 1)
plot(e5, "EMA 5", color.new(col, 55), 1)
plot(e6, "EMA 6", color.new(col, 65), 1)
fillCol = showFill ? color.new(col, 88) : color.new(col, 100)
fill(plot(e1, display = display.none), plot(e2, display = display.none), fillCol)
fill(plot(e2, display = display.none), plot(e3, display = display.none), fillCol)
fill(plot(e3, display = display.none), plot(e4, display = display.none), fillCol)
fill(plot(e4, display = display.none), plot(e5, display = display.none), fillCol)
fill(plot(e5, display = display.none), plot(e6, display = display.none), fillCol)

openStop = not showStop ? na : inL ? stopL : inS ? stopS : na
plot(openStop, "Open trade stop", color.new(color.red, 15), 1, plot.style_linebr)

plotshape(showBuy and buySig, "BUY", shape.labelup, location.belowbar, color.new(color.green, 0), text = "BUY", textcolor = color.white, size = size.tiny)
plotshape(showBuy and sellSig, "SELL (research)", shape.labeldown, location.abovebar, color.new(color.maroon, 0), text = "SELL?", textcolor = color.white, size = size.tiny)

if showExit and whyL != ""
    label.new(bar_index, high, whyL + " " + (rL >= 0 ? "+" : "") + str.tostring(math.round(rL, 2)) + "R", style = label.style_label_down,
         color = rL > 0 ? color.new(color.green, 15) : color.new(color.red, 15), textcolor = color.white, size = size.tiny,
         tooltip = "Long entry " + str.tostring(entL) + "  stop " + str.tostring(stopL))
if showExit and whyS != ""
    label.new(bar_index, low, "S-" + whyS + " " + (rS >= 0 ? "+" : "") + str.tostring(math.round(rS, 2)) + "R", style = label.style_label_up,
         color = rS > 0 ? color.new(color.green, 15) : color.new(color.red, 15), textcolor = color.white, size = size.tiny,
         tooltip = "Short entry " + str.tostring(entS) + "  stop " + str.tostring(stopS))

// ---------------- Alerts (use "Any alert() function call") ----------------
if buySig
    alert("TWI EMA Ribbon BUY signal on " + syminfo.ticker + " " + timeframe.period + " (entry next bar open)", alert.freq_once_per_bar_close)
if whyL != ""
    alert("TWI EMA Ribbon long " + whyL + " " + syminfo.ticker + " " + timeframe.period + " " + str.tostring(math.round(rL, 2)) + "R", alert.freq_once_per_bar_close)
if sellSig
    alert("TWI EMA Ribbon research SELL stack on " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)

// ---------------- Stats table ----------------
tPos = tblPos == "Top Left" ? position.top_left : tblPos == "Top Right" ? position.top_right : tblPos == "Bottom Left" ? position.bottom_left : position.bottom_right
var table tb = table.new(tPos, 2, 9, border_width = 1)
if showTable and barstate.islast
    isGold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
    fast = timeframe.in_seconds() < 14400
    winPct = nL > 0 ? 100.0 * winL / nL : na
    totR = grossL - lossL
    pf = lossL > 0 ? grossL / lossL : na
    openR = inL ? (close - entL) / riskL : na
    stateTxt = stackBull ? "BULL STACK" : stackBear ? "BEAR STACK (no short edge)" : "MIXED / loosening"
    table.cell(tb, 0, 0, "TWI EMA Ribbon", text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 20))
    table.cell(tb, 1, 0, stateTxt, text_color = color.white, text_size = size.small, bgcolor = stackBull ? color.new(color.green, 30) : stackBear ? color.new(color.red, 30) : color.new(color.gray, 30))
    table.cell(tb, 0, 1, "Long trades", text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 1, 1, str.tostring(nL) + "  win " + (na(winPct) ? "-" : str.tostring(math.round(winPct, 1)) + "%"), text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 0, 2, "Total / avg R", text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 1, 2, str.tostring(math.round(totR, 1)) + "R / " + (nL > 0 ? str.tostring(math.round(totR / nL, 2)) : "-") + "R", text_color = totR >= 0 ? color.lime : color.red, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 0, 3, "Profit factor (R)", text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 1, 3, na(pf) ? "-" : str.tostring(math.round(pf, 2)), text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 0, 4, "Open trade", text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 1, 4, inL ? "LONG " + (openR >= 0 ? "+" : "") + str.tostring(math.round(openR, 2)) + "R" : pendL ? "BUY pending (next open)" : "flat", text_color = inL ? color.lime : color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 0, 5, "Short (research)", text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 1, 5, trackShorts ? str.tostring(nS) + " trades  " + str.tostring(math.round(grossS - lossS, 1)) + "R" : "off", text_color = (trackShorts and grossS - lossS < 0) ? color.red : color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 0, 6, "Tested edge", text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 1, 6, isGold ? "gold H4, BUYS only" : "NOT this symbol: ~breakeven or worse", text_color = isGold ? color.lime : color.orange, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 0, 7, "Timeframe", text_color = color.white, text_size = size.small, bgcolor = fast ? color.new(color.red, 20) : color.new(color.black, 30))
    table.cell(tb, 1, 7, fast ? "FAST TF: this loses (backtest)" : "H4 or slower: OK", text_color = fast ? color.white : color.lime, text_size = size.small, bgcolor = fast ? color.new(color.red, 20) : color.new(color.black, 30))
    table.cell(tb, 0, 8, "History since", text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
    table.cell(tb, 1, 8, str.format_time(firstT, "yyyy-MM-dd") + "  (" + str.tostring(bar_index + 1) + " bars)", text_color = color.white, text_size = size.tiny, bgcolor = color.new(color.black, 30))
